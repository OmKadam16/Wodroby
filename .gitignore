# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ---------------------------------------------------------------------------
# Secrets — nothing in this block may ever reach GitHub.
# ---------------------------------------------------------------------------
# Every env file, including .env.example. Real values live only on this
# machine and in the host's dashboard.
.env
.env.*
*.env
.envrc

# Key material of any kind.
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.jks
*.keystore
id_rsa*
id_ed25519*
*.asc
*.gpg
secrets.json
credentials.json
service-account*.json

# ---------------------------------------------------------------------------
# Supabase — schema, migrations and the local CLI state.
# ---------------------------------------------------------------------------
/supabase
.supabase/
.branches/
.temp/

# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---------------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------------
/.next/
/out/
/build
/dist
*.tsbuildinfo
next-env.d.ts

# ---------------------------------------------------------------------------
# Tooling / host state
# ---------------------------------------------------------------------------
/coverage
.vercel
.netlify
.wrangler/
.turbo/
.eslintcache

# ---------------------------------------------------------------------------
# Editor & OS noise
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
!.vscode/extensions.json
/.claude/

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Cloudflare / OpenNext build output
.open-next/
